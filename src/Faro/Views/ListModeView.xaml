<UserControl x:Class="Faro.Views.ListModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Faro.Controls"
             xmlns:local="clr-namespace:Faro.Views">
    <UserControl.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg.OnSelected}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"/>
                        <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Primary" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <c:QuietListView x:Name="List" SelectionMode="Extended" BorderThickness="0" Background="Transparent" AlternationCount="2"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" FocusVisualStyle="{x:Null}"
                  GridViewColumnHeader.Click="Header_Click">
            <c:QuietListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Row" CornerRadius="5" Margin="6,0" Background="Transparent" Opacity="{Binding ItemOpacity}">
                                    <Border.RenderTransform><TranslateTransform x:Name="RowMove"/></Border.RenderTransform>
                                    <GridViewRowPresenter VerticalAlignment="Center" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.RowAlt}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.SelectedInactive}"/>
                                    </MultiTrigger>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" FillBehavior="Stop"/>
                                                    <DoubleAnimation Storyboard.TargetName="RowMove" Storyboard.TargetProperty="X" From="-14" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="RowMove" Storyboard.TargetProperty="X" To="24" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.DropTarget}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </c:QuietListView.ItemContainerStyle>
            <c:QuietListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn x:Name="ColName" Width="320">
                        <GridViewColumn.Header><TextBlock x:Name="HName" Text="Nombre" Tag="Name"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Indent, Converter={x:Static local:Converters.LeftMargin}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Disclosure" Background="Transparent" Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource SymbolFont}" FontSize="9" Style="{StaticResource Secondary}"
                                                   HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><RotateTransform x:Name="Rot" Angle="0"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Style="{StaticResource Primary}" Margin="3,0,0,0"/>
                                    <TextBox x:Name="RenameBox" Grid.Column="2" Loaded="RenameBox_Loaded" Style="{StaticResource MacTextBox}" Padding="2,0" Height="20"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding TagBrushes}" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="8" Height="8" Fill="{Binding}" Margin="-2,0,0,0" Stroke="White" StrokeThickness="1"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColLocation" Width="0">
                        <GridViewColumn.Header><TextBlock Text="Ubicación" Tag="Location"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LocationText}" ToolTip="{Binding Location}" Style="{StaticResource Secondary}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColDate" Width="170">
                        <GridViewColumn.Header><TextBlock Text="Fecha de modificación" Tag="Modified"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Secondary}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColSize" Width="90">
                        <GridViewColumn.Header><TextBlock Text="Tamaño" Tag="Size"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,0,6,0"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColKind" Width="190">
                        <GridViewColumn.Header><TextBlock Text="Tipo" Tag="Kind"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding KindText}" Style="{StaticResource Secondary}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColCreated" Width="0">
                        <GridViewColumn.Header><TextBlock Text="Fecha de creación" Tag="Created"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CreatedText}" Style="{StaticResource Secondary}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </c:QuietListView.View>
        </c:QuietListView>
        <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
</UserControl>
