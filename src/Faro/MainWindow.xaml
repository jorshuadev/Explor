<Window x:Class="Faro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Faro.Views"
        Title="Explor" Width="1100" Height="680" MinWidth="560" MinHeight="320"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Primary}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="210" MinWidth="0" MaxWidth="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Barra lateral ================= -->
        <Border x:Name="Sidebar" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel x:Name="Lights" DockPanel.Dock="Top" Orientation="Horizontal" Height="52" Margin="20,0,0,0" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top"></StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="SidebarStack" Margin="10,0,10,10"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="0" HorizontalAlignment="Right" Width="5" Margin="0,0,-2,0" Background="Transparent" ResizeBehavior="CurrentAndNext"
                      WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="5" DragCompleted="Splitter_DragCompleted"/>

        <!-- ================= Zona principal ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de herramientas -->
            <Border Background="{DynamicResource Bg.Toolbar}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,0,0,1">
                <Grid Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LightsInline" Orientation="Horizontal" Margin="12,0,10,0" Background="Transparent" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"></StackPanel>
                    <StackPanel x:Name="LeftTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BackBtn" Style="{StaticResource ToolButton}" Click="Back_Click" ToolTip="Atrás (Ctrl+[)" MouseRightButtonUp="Back_RightClick">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="14"/>
                        </Button>
                        <Button x:Name="ForwardBtn" Style="{StaticResource ToolButton}" Click="Forward_Click" ToolTip="Adelante (Ctrl+])">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="14"/>
                        </Button>
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,1" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" MouseRightButtonUp="Title_RightClick" Background="Transparent"/>
                    </StackPanel>

                    <StackPanel x:Name="RightTools" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- selector de vista -->
                        <Border x:Name="ViewSegment" Background="{DynamicResource Bg.Segment}" CornerRadius="7" Padding="1" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewIcons" Style="{StaticResource SegmentButton}" GroupName="vm" Click="ViewMode_Click" Tag="1" ToolTip="Iconos (Ctrl+1)">
                                    <Path Data="M0,0 h5 v5 h-5 z M7,0 h5 v5 h-5 z M0,7 h5 v5 h-5 z M7,7 h5 v5 h-5 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                                <RadioButton x:Name="ViewList" Style="{StaticResource SegmentButton}" GroupName="vm" Click="ViewMode_Click" Tag="2" ToolTip="Lista (Ctrl+2)">
                                    <Path Data="M0,0 h2 v2 h-2 z M4,0.4 h9 v1.2 h-9 z M0,4.5 h2 v2 h-2 z M4,4.9 h9 v1.2 h-9 z M0,9 h2 v2 h-2 z M4,9.4 h9 v1.2 h-9 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                                <RadioButton x:Name="ViewColumns" Style="{StaticResource SegmentButton}" GroupName="vm" Click="ViewMode_Click" Tag="3" ToolTip="Columnas (Ctrl+3)">
                                    <Path Data="M0,0 h14 v11 h-14 z M1.2,1.2 v8.6 h3.3 v-8.6 z M5.7,1.2 v8.6 h3.3 v-8.6 z M10.2,1.2 v8.6 h2.6 v-8.6 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                                <RadioButton x:Name="ViewGallery" Style="{StaticResource SegmentButton}" GroupName="vm" Click="ViewMode_Click" Tag="4" ToolTip="Galería (Ctrl+4)">
                                    <Path Data="M1,0 h12 v7.5 h-12 z M0,9.2 h3 v2.8 h-3 z M4.2,9.2 h3 v2.8 h-3 z M8.4,9.2 h3 v2.8 h-3 z M12.6,9.2 h1.6 v2.8 h-1.6 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SortBtn" Style="{StaticResource ToolButton}" Click="SortMenu_Click" ToolTip="Ordenar y agrupar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="15"/>
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="8" Margin="4,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShareBtn" Style="{StaticResource ToolButton}" Click="ShareMenu_Click" ToolTip="Compartir">
                            <TextBlock Text="&#xE72D;" Style="{StaticResource Glyph}" FontSize="15"/>
                        </Button>
                        <Button x:Name="TagBtn" Style="{StaticResource ToolButton}" Click="TagMenu_Click" ToolTip="Etiquetas">
                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="15"/>
                        </Button>
                        <Button x:Name="MoreBtn" Style="{StaticResource ToolButton}" Click="MoreMenu_Click" ToolTip="Más acciones">
                            <Border BorderBrush="{DynamicResource Fg.Toolbar}" BorderThickness="1.2" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" FontSize="10"/>
                            </Border>
                        </Button>
                        <!-- búsqueda -->
                        <Border x:Name="SearchBox" Background="{DynamicResource Bg.Field}" CornerRadius="7" Height="28" Width="170" Margin="8,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Fg.Secondary}"/>
                                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Buscar" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchText" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg.Primary}" CaretBrush="{DynamicResource Fg.Primary}"
                                         VerticalContentAlignment="Center" FontSize="13" Padding="0" TextChanged="SearchText_TextChanged" GotKeyboardFocus="SearchText_Focus" LostKeyboardFocus="SearchText_Blur"
                                         PreviewKeyDown="SearchText_KeyDown" SelectionBrush="{DynamicResource Accent}"/>
                                <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource ToolButton}" MinWidth="22" Height="22" Padding="0" Visibility="Collapsed" Click="SearchClear_Click">
                                    <Grid>
                                        <Ellipse Width="13" Height="13" Fill="{DynamicResource Fg.Tertiary}"/>
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="7" Foreground="{DynamicResource Bg.Window}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pestañas -->
            <Border x:Name="TabBar" Grid.Row="1" Background="{DynamicResource Bg.Tab}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,0,0,1" Height="30" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="TabStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Grid.Column="1" Style="{StaticResource ToolButton}" Click="NewTab_Click" ToolTip="Nueva pestaña (Ctrl+T)" Height="24" MinWidth="24">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Barra de búsqueda (alcance) -->
            <Border x:Name="ScopeBar" Grid.Row="2" Background="{DynamicResource Bg.Bar}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <DockPanel Margin="12,5">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <RadioButton x:Name="ScopeAll" Style="{StaticResource SegmentButton}" Width="Auto" Padding="8,0" GroupName="scope" Click="Scope_Click" Content="Este equipo"/>
                    <RadioButton x:Name="ScopeFolder" Style="{StaticResource SegmentButton}" Width="Auto" GroupName="scope" Click="Scope_Click" Margin="4,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="SearchStatus" Foreground="{DynamicResource Fg.Secondary}" FontSize="11.5" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ToolButton}" Height="22" Margin="8,0,0,0" Click="SearchHelp_Click" ToolTip="Ayuda de búsqueda">
                            <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Row="3" x:Name="ContentArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ViewHost" Focusable="False"/>
                <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Foreground="{DynamicResource Fg.Secondary}" FontSize="13" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="PreviewHost" Grid.Column="1" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="1,0,0,0"/>
            </Grid>

            <!-- Barra de ruta -->
            <Border x:Name="PathBar" Grid.Row="4" Background="{DynamicResource Bg.Window}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,1,0,0" Height="26">
                <Grid>
                    <ScrollViewer x:Name="PathScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Background="Transparent"
                                  MouseDoubleClick="PathBar_DoubleClick" ToolTip="Doble clic en el espacio libre para escribir una ruta">
                        <StackPanel x:Name="PathStack" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <TextBox x:Name="PathEdit" Style="{StaticResource MacTextBox}" Margin="6,1" Padding="6,0" FontSize="12" Visibility="Collapsed"
                             PreviewKeyDown="PathEdit_KeyDown" LostKeyboardFocus="PathEdit_Lost" TextChanged="PathEdit_TextChanged"/>
                </Grid>
            </Border>

            <!-- Barra de estado -->
            <Border x:Name="StatusBar" Grid.Row="5" Background="{DynamicResource Bg.Window}" BorderBrush="{DynamicResource Line.Separator}" BorderThickness="0,1,0,0" Height="26">
                <Grid>
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Fg.Secondary}"/>
                    <StackPanel x:Name="ZoomPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="9" Margin="0,0,6,0"/>
                        <Slider x:Name="ZoomSlider" Style="{StaticResource MiniSlider}" Width="90" Minimum="32" Maximum="256" ValueChanged="Zoom_Changed"/>
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="13" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
